rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Flourish MOBILE APP — Cloud Storage Security Rules
//
// Belongs to the dedicated app Firebase project(s) (flourish-app /
// flourish-app-dev). Photos & videos are stored under an owner-scoped,
// unguessable path: babies/{babyId}/memories/{uid}/{file}
//
// Writes are locked to the authenticated uploader, verified against baby
// membership in Firestore, and validated for content type and size (mirrors
// the client checks in src/firebase/storage.ts).
//
// NOTE on reads: the current app resolves stored paths with getDownloadURL(),
// so read-side membership enforcement requires removing those bearer URLs too.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidMedia() {
      return request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    function babyData(babyId) {
      return firestore.get(/databases/(default)/documents/babies/$(babyId)).data;
    }

    function isBabyMember(babyId) {
      return isSignedIn() && request.auth.uid in babyData(babyId).memberIds;
    }

    match /babies/{babyId}/memories/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isBabyMember(babyId)
        && isValidMedia();
      allow delete: if isSignedIn()
        && request.auth.uid == uid
        && isBabyMember(babyId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
