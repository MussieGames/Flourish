rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Flourish MOBILE APP — Cloud Storage Security Rules
//
// Belongs to the dedicated app Firebase project(s) (flourish-app /
// flourish-app-dev). Photos & videos live at babies/{babyId}/memories/{uid}/{file}
//
// Reads and writes are both locked to the authenticated uploader. Storage Rules
// cannot query Firestore, so they cannot check baby-membership — and the
// filename is NOT a security boundary (it is generated client-side and must
// never be treated as a secret). Restricting reads to the uploader is therefore
// the only enforceable rule here, and it is the safe default: today every
// member of a baby IS the owner, because no invite flow ships yet.
//
// BEFORE family sharing ships, viewing another member's upload needs one of:
//   • custom auth claims carrying the caller's babyIds, checked here; or
//   • short-lived signed URLs minted by a Cloud Function that checks Firestore.
// Do not widen `read` back to "any signed-in user" to make sharing work — that
// would let any account with a path read another family's photos.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit allow-list rather than `image/.*` — a wildcard also admits
    // image/svg+xml, which can carry script if a file is ever rendered on web.
    function isAllowedType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/heic',
        'image/heif',
        'image/webp',
        'video/mp4',
        'video/quicktime'
      ];
    }

    function isValidMedia() {
      return request.resource.size > 0
        && request.resource.size < 15 * 1024 * 1024
        && isAllowedType();
    }

    match /babies/{babyId}/memories/{uid}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && isValidMedia();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
