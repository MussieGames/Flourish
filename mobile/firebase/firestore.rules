rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Flourish MOBILE APP — Firestore Security Rules
//
// These rules belong to the DEDICATED app Firebase project(s)
// (flourish-app / flourish-app-dev) — NOT the marketing/CTA project.
// The CTA/waitlist rules live separately in /firestore.rules at the repo root.
//
// Security model: a baby's data is private by default. Every document is owned
// by exactly one parent (`ownerId`) and visible only to an explicit allow-list
// of family members (`memberIds`). No public reads, no cross-account access.
// Every write is shape-validated. Default-deny everything else.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function babyData(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId)).data;
    }

    function isMember(babyId) {
      return isSignedIn() && request.auth.uid in babyData(babyId).memberIds;
    }

    function isOwner(babyId) {
      return isSignedIn() && request.auth.uid == babyData(babyId).ownerId;
    }

    function isNonEmptyString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isBoundedString(value, max) {
      return value is string && value.size() <= max;
    }

    function isNullableBoundedString(value, max) {
      return value == null || isBoundedString(value, max);
    }

    function isStringListUpTo8(value, max) {
      return value is list
        && value.size() <= 8
        && (value.size() < 1 || isBoundedString(value[0], max))
        && (value.size() < 2 || isBoundedString(value[1], max))
        && (value.size() < 3 || isBoundedString(value[2], max))
        && (value.size() < 4 || isBoundedString(value[3], max))
        && (value.size() < 5 || isBoundedString(value[4], max))
        && (value.size() < 6 || isBoundedString(value[5], max))
        && (value.size() < 7 || isBoundedString(value[6], max))
        && (value.size() < 8 || isBoundedString(value[7], max));
    }

    function isValidJournalCreate(babyId) {
      return request.resource.data.keys().hasOnly([
          'babyId', 'authorId', 'body', 'mood', 'tags', 'storagePath', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['babyId', 'authorId', 'body', 'tags', 'createdAt'])
        && request.resource.data.babyId == babyId
        && request.resource.data.authorId == request.auth.uid
        && isBoundedString(request.resource.data.body, 4000)
        && (!('mood' in request.resource.data)
            || isNullableBoundedString(request.resource.data.mood, 16))
        && isStringListUpTo8(request.resource.data.tags, 24)
        && (!('storagePath' in request.resource.data)
            || isNullableBoundedString(request.resource.data.storagePath, 512))
        && request.resource.data.createdAt is timestamp;
    }

    function isValidMilestoneCreate(babyId) {
      return request.resource.data.keys().hasOnly([
          'babyId', 'key', 'label', 'emoji', 'typicalAge', 'status', 'authorId', 'capturedAt', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'babyId', 'key', 'label', 'emoji', 'typicalAge', 'status', 'authorId', 'createdAt'
        ])
        && request.resource.data.babyId == babyId
        && request.resource.data.authorId == request.auth.uid
        && isBoundedString(request.resource.data.key, 80)
        && isNonEmptyString(request.resource.data.label, 80)
        && isBoundedString(request.resource.data.emoji, 16)
        && isBoundedString(request.resource.data.typicalAge, 40)
        && request.resource.data.status in ['upcoming', 'captured']
        && (!('capturedAt' in request.resource.data) || request.resource.data.capturedAt is timestamp)
        && request.resource.data.createdAt is timestamp;
    }

    function isValidEventCreate(babyId) {
      return request.resource.data.keys().hasOnly([
          'babyId', 'type', 'title', 'meta', 'date', 'createdAt'
        ])
        && request.resource.data.keys().hasAll(['babyId', 'type', 'title', 'date', 'createdAt'])
        && request.resource.data.babyId == babyId
        && request.resource.data.type in ['milestone', 'memory', 'appointment']
        && isNonEmptyString(request.resource.data.title, 80)
        && (!('meta' in request.resource.data)
            || isNullableBoundedString(request.resource.data.meta, 120))
        && isNonEmptyString(request.resource.data.date, 10)
        && request.resource.data.createdAt is timestamp;
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isUser(uid);

      allow create: if isUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.plan in ['seedling', 'bloom', 'heirloom'];

      allow update: if isUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.plan in ['seedling', 'bloom', 'heirloom'];

      allow delete: if false;
    }

    // ── Babies ─────────────────────────────────────────────────────────
    match /babies/{babyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasOnly([request.auth.uid])
        && isNonEmptyString(request.resource.data.name, 40);

      allow update: if isOwner(babyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId in request.resource.data.memberIds
        && isNonEmptyString(request.resource.data.name, 40);

      allow delete: if isOwner(babyId);

      // ── Memories ─────────────────────────────────────────────────────
      match /memories/{memoryId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.kind in ['photo', 'video', 'note']
          && isNonEmptyString(request.resource.data.title, 80)
          && isBoundedString(request.resource.data.caption, 500);
        allow update, delete: if isMember(babyId)
          && (resource.data.authorId == request.auth.uid || isOwner(babyId));
      }

      // ── Milestones ───────────────────────────────────────────────────
      match /milestones/{milestoneId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && isValidMilestoneCreate(babyId);
        allow update: if isMember(babyId)
          && request.resource.data.status in ['upcoming', 'captured'];
        allow delete: if isOwner(babyId);
      }

      // ── Journal ──────────────────────────────────────────────────────
      match /journal/{entryId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && isValidJournalCreate(babyId);
        allow update, delete: if isMember(babyId)
          && (resource.data.authorId == request.auth.uid || isOwner(babyId));
      }

      // ── Calendar events ──────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && isValidEventCreate(babyId);
        allow update, delete: if isMember(babyId);
      }
    }

    // Default deny — anything not explicitly matched above is forbidden.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
