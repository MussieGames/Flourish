rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Waitlist signups must go through the reCAPTCHA-gated Cloud Function.
    // The Admin SDK bypasses rules; browser clients get no direct access.
    match /waitlist/{signupId} {
      allow read, write: if false;
    }

    // Legacy SendGrid / Trigger Email collections — server only.
    match /auto_reply/{document=**} {
      allow read, write: if false;
    }

    match /mail/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
