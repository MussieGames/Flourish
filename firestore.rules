rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Waitlist — SERVER ONLY.
    //
    // Signups must go through the addWaitlistEmail Cloud Function, which
    // verifies a reCAPTCHA Enterprise assessment before writing with the
    // Admin SDK (which bypasses these rules).
    //
    // Client creates were previously allowed here so the page could write
    // directly. That let anyone skip reCAPTCHA entirely by posting to the
    // Firestore REST API: unlimited junk signups, and — because a create
    // triggers a confirmation email — a way to send mail from this domain to
    // any address, repeatedly. Do not reopen it.
    match /waitlist/{signupId} {
      allow read, write: if false;
    }

    // Legacy SendGrid / Trigger Email collections — server only.
    match /auto_reply/{document=**} {
      allow read, write: if false;
    }

    match /mail/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
