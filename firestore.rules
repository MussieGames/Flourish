rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public CTA may create waitlist signups only.
    // Clients cannot read the list or change confirmation fields.
    // sendWaitlistConfirmation (Admin SDK) still updates docs after create.
    match /waitlist/{signupId} {
      allow create: if request.resource.data.keys().hasOnly([
          'email', 'name', 'source', 'page', 'createdAt', 'userAgent'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320
        && request.resource.data.email.matches('.*@.*\\..*')
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() < 120))
        && (!('source' in request.resource.data)
            || (request.resource.data.source is string
                && request.resource.data.source.size() < 80))
        && (!('page' in request.resource.data)
            || (request.resource.data.page is string
                && request.resource.data.page.size() < 80))
        && (!('userAgent' in request.resource.data)
            || (request.resource.data.userAgent is string
                && request.resource.data.userAgent.size() < 512));

      allow read, update, delete: if false;
    }

    // Legacy SendGrid / Trigger Email collections — server only.
    match /auto_reply/{document=**} {
      allow read, write: if false;
    }

    match /mail/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
