rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Flourish MOBILE APP — Cloud Storage Security Rules
//
// Belongs to the dedicated app Firebase project(s) (flourish-app /
// flourish-app-dev). Photos & videos are stored under an owner-scoped,
// unguessable path: babies/{babyId}/memories/{uid}/{file}
//
// Reads and writes are checked against the Firestore baby membership document
// so removing a member also removes access to private media. Writes are also
// locked to the authenticated uploader and validated for content type and size
// (mirrors the client checks in src/firebase/storage.ts).
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function babyData(babyId) {
      return firestore.get(/databases/(default)/documents/babies/$(babyId)).data;
    }

    function isMember(babyId) {
      return isSignedIn() && request.auth.uid in babyData(babyId).memberIds;
    }

    function isOwner(babyId) {
      return isSignedIn() && request.auth.uid == babyData(babyId).ownerId;
    }

    function isValidMedia() {
      return request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    match /babies/{babyId}/memories/{uid}/{fileName} {
      allow read: if isMember(babyId);
      allow create, update: if isMember(babyId)
        && request.auth.uid == uid
        && isValidMedia();
      allow delete: if isMember(babyId)
        && (request.auth.uid == uid || isOwner(babyId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
