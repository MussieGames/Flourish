rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Flourish MOBILE APP — Firestore Security Rules
//
// These rules belong to the DEDICATED app Firebase project(s)
// (flourish-app / flourish-app-dev) — NOT the marketing/CTA project.
// The CTA/waitlist rules live separately in /firestore.rules at the repo root.
//
// Security model: a baby's data is private by default. Every document is owned
// by exactly one parent (`ownerId`) and visible only to an explicit allow-list
// of family members (`memberIds`). No public reads, no cross-account access.
// Every write is shape-validated. Default-deny everything else.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function babyData(babyId) {
      return get(/databases/$(database)/documents/babies/$(babyId)).data;
    }

    function isMember(babyId) {
      return isSignedIn() && request.auth.uid in babyData(babyId).memberIds;
    }

    function isOwner(babyId) {
      return isSignedIn() && request.auth.uid == babyData(babyId).ownerId;
    }

    function isNonEmptyString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isBoundedString(value, max) {
      return value is string && value.size() <= max;
    }

    function isOptionalBoundedString(data, field, max) {
      return !data.keys().hasAny([field])
        || data[field] == null
        || isBoundedString(data[field], max);
    }

    function isValidTagAt(tags, index) {
      return tags.size() <= index || isBoundedString(tags[index], 24);
    }

    function isValidTags(tags) {
      return tags is list
        && tags.size() <= 8
        && isValidTagAt(tags, 0)
        && isValidTagAt(tags, 1)
        && isValidTagAt(tags, 2)
        && isValidTagAt(tags, 3)
        && isValidTagAt(tags, 4)
        && isValidTagAt(tags, 5)
        && isValidTagAt(tags, 6)
        && isValidTagAt(tags, 7);
    }

    function isDocAuthor(data) {
      return data.keys().hasAll(['authorId']) && data.authorId == request.auth.uid;
    }

    function isAuthorOrOwner(babyId, data) {
      return isDocAuthor(data) || isOwner(babyId);
    }

    function isValidJournalEntry(babyId, data) {
      return data.keys().hasOnly(['babyId', 'authorId', 'body', 'mood', 'tags', 'storagePath', 'createdAt'])
        && data.keys().hasAll(['babyId', 'authorId', 'body', 'tags', 'createdAt'])
        && data.babyId == babyId
        && data.authorId is string
        && isBoundedString(data.body, 4000)
        && isOptionalBoundedString(data, 'mood', 8)
        && isOptionalBoundedString(data, 'storagePath', 500)
        && isValidTags(data.tags)
        && data.createdAt is timestamp;
    }

    function isValidCalendarEvent(babyId, data) {
      return data.keys().hasOnly(['babyId', 'authorId', 'type', 'title', 'meta', 'date', 'createdAt'])
        && data.keys().hasAll(['babyId', 'authorId', 'type', 'title', 'meta', 'date', 'createdAt'])
        && data.babyId == babyId
        && data.authorId is string
        && data.type in ['milestone', 'memory', 'appointment']
        && isNonEmptyString(data.title, 80)
        && isBoundedString(data.meta, 120)
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.createdAt is timestamp;
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isUser(uid);

      allow create: if isUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.plan in ['seedling', 'bloom', 'heirloom'];

      allow update: if isUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.plan in ['seedling', 'bloom', 'heirloom'];

      allow delete: if false;
    }

    // ── Babies ─────────────────────────────────────────────────────────
    match /babies/{babyId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasOnly([request.auth.uid])
        && isNonEmptyString(request.resource.data.name, 40);

      allow update: if isOwner(babyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId in request.resource.data.memberIds
        && isNonEmptyString(request.resource.data.name, 40);

      allow delete: if isOwner(babyId);

      // ── Memories ─────────────────────────────────────────────────────
      match /memories/{memoryId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.kind in ['photo', 'video', 'note']
          && isNonEmptyString(request.resource.data.title, 80)
          && isBoundedString(request.resource.data.caption, 500);
        allow update, delete: if isMember(babyId)
          && (resource.data.authorId == request.auth.uid || isOwner(babyId));
      }

      // ── Milestones ───────────────────────────────────────────────────
      match /milestones/{milestoneId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && isNonEmptyString(request.resource.data.label, 80)
          && request.resource.data.status in ['upcoming', 'captured'];
        allow update: if isMember(babyId)
          && request.resource.data.status in ['upcoming', 'captured'];
        allow delete: if isOwner(babyId);
      }

      // ── Journal ──────────────────────────────────────────────────────
      match /journal/{entryId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && request.resource.data.authorId == request.auth.uid
          && isValidJournalEntry(babyId, request.resource.data);
        allow update: if isMember(babyId)
          && isAuthorOrOwner(babyId, resource.data)
          && isValidJournalEntry(babyId, request.resource.data)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.babyId == resource.data.babyId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isMember(babyId)
          && isAuthorOrOwner(babyId, resource.data);
      }

      // ── Calendar events ──────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isMember(babyId);
        allow create: if isMember(babyId)
          && request.resource.data.authorId == request.auth.uid
          && isValidCalendarEvent(babyId, request.resource.data);
        allow update: if isMember(babyId)
          && isAuthorOrOwner(babyId, resource.data)
          && isValidCalendarEvent(babyId, request.resource.data)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.babyId == resource.data.babyId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isMember(babyId)
          && isAuthorOrOwner(babyId, resource.data);
      }
    }

    // Default deny — anything not explicitly matched above is forbidden.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
