# ───────────────────────────────────────────────────────────────────
# Flourish MOBILE APP — Firebase Web App configuration (LOCAL DEV)
# ───────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values from the DEV app project
# (flourish-app-dev): Firebase console → Project settings → General →
# Your apps → Web app → SDK setup → "Config".
#
# For production builds, these values live in `eas.json` (production profile)
# and point at the flourish-app project instead — see eas.json.
#
# SECURITY NOTE:
#   These EXPO_PUBLIC_* values are bundled into the client and are NOT secret.
#   That is expected and safe for a Firebase Web app — the apiKey only
#   identifies the project. All real security is enforced server-side by the
#   Security Rules in mobile/firebase/ and by Firebase App Check.
#   Never put service-account keys or private secrets in EXPO_PUBLIC_* vars.
# ───────────────────────────────────────────────────────────────────

# Dev project: flourish-app-dev. Copy apiKey / senderId / appId from its Web app
# config. Verify STORAGE_BUCKET against the console — new projects use the
# ".firebasestorage.app" suffix (older ones used ".appspot.com").
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=flourish-app-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=flourish-app-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=flourish-app-dev.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check — reCAPTCHA v3 site key (web) used for the debug/dev provider.
# In production builds use Play Integrity (Android) / App Attest (iOS).
EXPO_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=

# Optional: set to "1" to register an App Check debug token during development.
EXPO_PUBLIC_FIREBASE_APPCHECK_DEBUG=
