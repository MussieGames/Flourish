rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Waitlist signups are server-only (Cloud Function with reCAPTCHA).
    match /waitlist/{document=**} {
      allow read, write: if false;
    }

    // Legacy SendGrid / Trigger Email collections — server only.
    match /auto_reply/{document=**} {
      allow read, write: if false;
    }

    match /mail/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
